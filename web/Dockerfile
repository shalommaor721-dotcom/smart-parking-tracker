# הקובץ הזה הוא מתכון לבניית התוכנית שמציגה את לוח הבקרה בדפדפן.

# נקודת ההתחלה: תוכנה מוכנה בשם Nginx שיודעת להציג דפי אינטרנט. הגרסה "alpine" קטנה ומהירה
FROM nginx:1.27-alpine

# מחליפים את קובץ ההגדרות של Nginx בקובץ שלנו.
# הוא קובע שני דברים: להציג את דפי הלוח, ולהעביר בקשות של נתונים לשרת הנתונים
COPY nginx.conf /etc/nginx/conf.d/default.conf

# מעתיקים את שלושת קבצי הלוח (מבנה, קוד ועיצוב) לתיקייה שממנה Nginx מציג דפים
COPY index.html app.js style.css /usr/share/nginx/html/

# הערה בלבד: התוכנית מקשיבה בפורט 80. הפורט שנפתח במחשב שלנו נקבע בקובץ docker-compose.yml
EXPOSE 80
# אין כאן פקודת הפעלה, כי ל-Nginx כבר יש אחת מובנית
