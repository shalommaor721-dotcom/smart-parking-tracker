# הקובץ הזה הוא מתכון לבניית התוכנית של שרת הנתונים (api).
# כל שורה היא שלב אחד בבנייה, מלמעלה למטה.

# נקודת ההתחלה: מערכת קטנה שכבר מותקנת בה התוכנה Node.js שמריצה את הקוד שלנו
FROM node:22-alpine

# התיקייה שבה נעבוד בתוך התוכנית. כל הפקודות הבאות ירוצו שם
WORKDIR /app

# מעתיקים קודם רק את שני הקבצים שמפרטים אילו חבילות הקוד צריך.
# עושים את זה לפני העתקת הקוד, כי Docker זוכר שלבים שלא השתנו ולא מריץ אותם שוב,
# וככה בנייה אחרי שינוי קטן בקוד לא מורידה את כל החבילות מחדש
COPY package*.json ./
# מתקינים את החבילות לפי הרשימה המדויקת. "--omit=dev" מדלג על חבילות שנחוצות רק למי שכותב את הקוד
RUN npm ci --omit=dev

# מעתיקים את קובץ הקוד של השרת
COPY server.js ./

# מגדירים שהתוכנית רצה במצב אמיתי ולא במצב ניסיון
ENV NODE_ENV=production
# הערה בלבד: השרת מקשיב בפורט 3000. הפתיחה האמיתית החוצה נעשית בקובץ docker-compose.yml
EXPOSE 3000
# מריצים את התוכנית כמשתמש רגיל ולא כמנהל, מטעמי אבטחה
USER node
# הפקודה שרצה כשהתוכנית מתחילה: מפעילה את השרת
CMD ["node", "server.js"]
